<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة مشتركي المولدات</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            color: #333;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: #fff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 20px;
        }

        .form-card, .controls, .summary-card {
            margin-bottom: 20px;
        }

        .form-card {
            background: #eef2f3;
            padding: 15px;
            border-radius: 8px;
        }

        .form-card h3 {
            margin-bottom: 10px;
            color: #34495e;
        }

        form {
            display: flex;
            gap: 10px;
        }

        input[type="text"], input[type="number"] {
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 16px;
        }

        button {
            padding: 10px 20px;
            background-color: #27ae60;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #219653;
        }

        .controls input {
            width: 100%;
            padding: 12px;
            border: 1px solid #bdc3c7;
            border-radius: 6px;
        }

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #2c3e50;
            color: white;
        }

        tr.paid {
            background-color: #e8f8f5;
        }

        tr.unpaid {
            background-color: #fdedec;
        }

        .status-btn {
            padding: 6px 12px;
            border-radius: 20px;
            border: none;
            cursor: pointer;
            font-weight: bold;
            color: white;
        }

        tr.paid .status-btn {
            background-color: #27ae60;
        }

        tr.unpaid .status-btn {
            background-color: #e74c3c;
        }

        .delete-btn {
            background-color: #c0392b;
            padding: 5px 10px;
            font-size: 14px;
        }
        .delete-btn:hover {
            background-color: #962d22;
        }

        .summary-card {
            background: #f8f9f9;
            padding: 15px;
            border-radius: 8px;
            display: flex;
            justify-content: space-around;
            font-weight: bold;
            font-size: 16px;
            border: 1px solid #e5e7e9;
        }

        .green-text { color: #27ae60; }
        .red-text { color: #e74c3c; }
    </style>
</head>
<body>

    <div class="container">
        <h1>⚡ نظام إدارة مشتركي المولدات</h1>

        <!-- نموذج إضافة مشترك جديد -->
        <div class="form-card">
            <h3>إضافة مشترك جديد</h3>
            <form id="subscriberForm">
                <input type="text" id="subscriberName" placeholder="اسم المشترك ثلاثي" required>
                <input type="number" id="subscriberAmperes" placeholder="عدد الأمبيرات" min="1" required>
                <button type="submit">إضافة المشترك</button>
            </form>
        </div>

        <!-- شريط البحث والتحكم -->
        <div class="controls">
            <input type="text" id="searchInput" placeholder="🔍 بحث عن اسم مشترك...">
        </div>

        <!-- جدول المشتركين -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>الرقم</th>
                        <th>اسم المشترك</th>
                        <th>عدد الأمبيرات</th>
                        <th>حالة الدفع</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="subscribersTableBody">
                    <!-- سيتم تعبئة البيانات هنا تلقائياً -->
                </tbody>
            </table>
        </div>

        <!-- ملخص الحسابات -->
        <div class="summary-card">
            <p>إجمالي المشتركين: <span id="totalCount">0</span></p>
            <p>إجمالي الأمبيرات: <span id="totalAmperes">0</span></p>
            <p>الدافعين: <span id="paidCount" class="green-text">0</span> | غير الدافعين: <span id="unpaidCount" class="red-text">0</span></p>
        </div>
    </div>

    <script>
        let subscribers = JSON.parse(localStorage.getItem('subscribers')) || [];

        const form = document.getElementById('subscriberForm');
        const nameInput = document.getElementById('subscriberName');
        const amperesInput = document.getElementById('subscriberAmperes');
        const tableBody = document.getElementById('subscribersTableBody');
        const searchInput = document.getElementById('searchInput');

        const totalCountEl = document.getElementById('totalCount');
        const totalAmperesEl = document.getElementById('totalAmperes');
        const paidCountEl = document.getElementById('paidCount');
        const unpaidCountEl = document.getElementById('unpaidCount');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const newSubscriber = {
                id: Date.now(),
                name: nameInput.value.trim(),
                amperes: parseInt(amperesInput.value),
                isPaid: false
            };

            subscribers.push(newSubscriber);
            saveAndRender();
            
            nameInput.value = '';
            amperesInput.value = '';
        });

        function saveAndRender() {
            localStorage.setItem('subscribers', JSON.stringify(subscribers));
            renderTable(subscribers);
        }

        function renderTable(data) {
            tableBody.innerHTML = '';
            
            let totalAmperes = 0;
            let paidCount = 0;
            let unpaidCount = 0;

            data.forEach((sub, index) => {
                totalAmperes += sub.amperes;
                if (sub.isPaid) {
                    paidCount++;
                } else {
                    unpaidCount++;
                }

                const row = document.createElement('tr');
                row.className = sub.isPaid ? 'paid' : 'unpaid';

                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${sub.name}</td>
                    <td>${sub.amperes} أمبير</td>
                    <td>
                        <button class="status-btn" onclick="toggleStatus(${sub.id})">
                            ${sub.isPaid ? '✔ دافع' : '✖ غير دافع'}
                        </button>
                    </td>
                    <td>
                        <button class="delete-btn" onclick="deleteSubscriber(${sub.id})">حذف</button>
                    </td>
                `;
                tableBody.appendChild(row);
            });

            totalCountEl.textContent = data.length;
            totalAmperesEl.textContent = totalAmperes;
            paidCountEl.textContent = paidCount;
            unpaidCountEl.textContent = unpaidCount;
        }

        function toggleStatus(id) {
            subscribers = subscribers.map(sub => {
                if (sub.id === id) {
                    sub.isPaid = !sub.isPaid;
                }
                return sub;
            });
            saveAndRender();
        }

        function deleteSubscriber(id) {
            if (confirm('هل أنت متأكد من حذف هذا المشترك؟')) {
                subscribers = subscribers.filter(sub => sub.id !== id);
                saveAndRender();
            }
        }

        searchInput.addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            const filtered = subscribers.filter(sub => sub.name.toLowerCase().includes(term));
            renderTable(filtered);
        });

        renderTable(subscribers);
    </script>
</body>
</html>
